[Unit]
Description=Restore Gigabyte RGB Fusion lighting
Documentation=https://github.com/
# The hidraw node is granted to the local session via TAG+="uaccess", so this
# has to run as a user unit after the graphical session is up.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
# --wait polls for the controller rather than guessing how long a cold boot
# needs to enumerate it: it returns the moment the device is there, and gives
# up instead of hanging the session if it never appears.
ExecStart=/usr/local/bin/GigabyteRGBController --restore --wait 20
# Turning the lighting off on shutdown is optional; drop this line to keep the
# last colour while the machine is powered down.
# ExecStop=/usr/local/bin/GigabyteRGBController --set off

[Install]
WantedBy=graphical-session.target
